+      ).rotation.z = a;
+    }
+  } else if (id === "gear-case") {
+    box(g, [0.28, 0.025, 0.31], [0, -0.055, 0], polymer, 0.016);
+    for (const x of [-0.13, 0.13])
+      box(g, [0.02, 0.12, 0.31], [x, 0, 0], polymer, 0.008);
