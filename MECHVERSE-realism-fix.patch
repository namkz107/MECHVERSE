+            new T.Vector3(0.205, -0.025, 0.15 + j * 0.008),
+            new T.Vector3(0.27, 0, 0.17 + j * 0.008),
+            new T.Vector3(0.285, 0.025, 0.12),
+            new T.Vector3(0.285, 0.025, -0.15 - j * 0.008),
