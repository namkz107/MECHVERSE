{
  "name": "mechverse-frontend",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 5173 --strictPort --open",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write src scripts tests vite.config.ts vitest.config.ts playwright.config.ts",
    "test:e2e": "playwright test",
    "asset:build": "tsx scripts/build-fan.ts",
    "asset:industrial": "tsx scripts/build-industrial.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.4"
  }
}
